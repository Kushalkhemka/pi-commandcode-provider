# Optional. If omitted, the server creates data/.master-key with mode 0600.
# QUOTA_BOARD_MASTER_KEY=<64-character hex or base64-encoded 32-byte key>

QUOTA_BOARD_PORT=8787
QUOTA_BOARD_HOST=127.0.0.1

# Required only when accepting telemetry ingestion from a non-loopback client.
# QUOTA_BOARD_INGEST_TOKEN=<long random token>
